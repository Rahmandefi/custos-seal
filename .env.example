# Copy to .env (mode 600). Fill values locally. Never commit .env.

# NEAR AI Cloud API key from https://cloud.near.ai (not a NEAR wallet key)
NEAR_AI_API_KEY=

# Canonical Confidential TEE model id
NEAR_AI_MODEL=

# Optional: dump attestation reports for scripts/verify_report.py (set to 1)
NEAR_AI_DUMP_REPORTS=

# Testnet RPC and accounts (defaults exist in src/near.mjs)
NEAR_RPC=
NEAR_CONTRACT=
NEAR_OWNER=
NEAR_WRITER=

# Function-call writer key file for local CLI only (never commit the file)
NEAR_WRITER_KEYFILE=

# Server-side only (Vercel). Never commit values.
# NEAR_WRITER_PRIVATE_KEY=ed25519:...
# NEAR_OWNER_PRIVATE_KEY=ed25519:...
# CASE_SALT=64 hex chars
# EVIDENCE_SALT=

# Skip independent dcap-qvl during POST /analyze (set to 1 on Vercel)
SKIP_DCAP=

# Server-side write gate. Required for POST /analyze, /custody/*, /api/security.
# Never commit the value. Frontend may send it from sessionStorage custos-write-token.
CUSTOS_WRITE_TOKEN=

# Public demo: sample-only Analyze + stolen-key Attempts without operator token.
# Rate limit is per-instance (in-memory) and resets on cold start.
DEMO_MODE=
DEMO_RPM=
